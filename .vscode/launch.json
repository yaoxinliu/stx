    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "DebugRust",
            "program": "${workspaceFolder}/toy/rust/hello/target/debug/hello",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "DebugCppHello",
            "program": "${workspaceFolder}/toy/cpp/hello/a.out",
            "args": [],
            "cwd": "${workspaceFolder}",                        
            "preLaunchTask": "build cpp/hello",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "DebugCppWorld",
            "program": "${workspaceFolder}/toy/cpp/world/a.out",
            "args": [],
            "cwd": "${workspaceFolder}",                        
            "preLaunchTask": "build cpp/world",
        },
        {
            "type": "node",
            "request": "launch",
            "name": "DebugTypeScript",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/toy/nodejs/main.ts"
        }
    ]
}